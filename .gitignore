# ---------------------------------------------------------------------------
# Build output - never commit compiled artifacts. The build regenerates them.
# ---------------------------------------------------------------------------
target/
docker/deployments/*.war
docker/deployments/*.deployed
docker/deployments/*.failed
docker/deployments/*.undeployed
docker/deployments/*.isdeploying
docker/deployments/*.pending
docker/deployments/*.skipdeploy
docker/deployments/*.dodeploy

# ---------------------------------------------------------------------------
# IDE metadata - personal to each developer, not to the project.
# ---------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
bin/
nbproject/private/

# ---------------------------------------------------------------------------
# Local environment overrides. Committing real secrets is the single most
# common security incident in small teams - keep .env out of git and commit
# a .env.example with placeholder values instead.
# ---------------------------------------------------------------------------
.env
*.local

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
*.tmp
hs_err_pid*.log
